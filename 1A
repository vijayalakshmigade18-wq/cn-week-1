#include <stdio.h>
#include <string.h>

int main()
{
    char a[100], b[200], ch;
    int pos, i, j = 0;

    scanf("%s", a);
    scanf("%d", &pos);
    scanf(" %c", &ch);

    strcpy(b, "DLESTX");
    j = strlen(b);

    for (i = 0; a[i] != '\0'; i++)
    {
        if (i == pos - 1)
        {
            b[j++] = 'D';
            b[j++] = 'L';
            b[j++] = 'E';
            b[j++] = ch;
            b[j++] = 'D';
            b[j++] = 'L';
            b[j++] = 'E';
        }

        b[j++] = a[i];
    }

    b[j] = '\0';
    strcat(b, "DLEETX");

    printf("Stuffed Frame: %s", b);

    return 0;
}
